# Keep development locally. Set production in the deployment platform.
APP_ENV=development

# Optional in development; all three are mandatory in production.
DATABASE_URL=
SECRET_KEY=
JWT_SECRET_KEY=

# Initial administrator used in every environment, including seed-demo.
# Set real values only in the deployment platform or an ignored local .env file.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Public demo reset. Disabled by default; the automatic interval is in seconds.
DEMO_RESET_ENABLED=false
DEMO_RESET_INTERVAL_SECONDS=0
